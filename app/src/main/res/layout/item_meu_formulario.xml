<?xml version="1.0" encoding="utf-8"?>
<!-- .card-formulario do cidadão.
     txtStatus: troque fundo e cor do texto conforme o status:
       EM_ANALISE   -> bg_badge_analise   + @color/status_analise_texto
       EM_ANDAMENTO -> bg_badge_andamento + @color/status_andamento_texto
       CONCLUIDO    -> bg_badge_concluido + @color/status_concluido_texto
     layoutResposta: VISIBLE só quando "resposta" não for vazia. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMotivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="RECLAMACAO" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/Badge"
            android:background="@drawable/bg_badge_analise"
            android:textColor="@color/status_analise_texto"
            tools:text="Em análise" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="15sp"
        tools:text="Av. Fábio Barnabé - Jardim Morada do Sol" />

    <TextView
        android:id="@+id/txtData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_claro"
        android:textSize="13sp"
        tools:text="Ocorrido em: 2026-10-15" />

    <!-- .card-formulario-resposta -->
    <LinearLayout
        android:id="@+id/layoutResposta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_resposta"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resposta_prefeitura"
            android:textColor="@color/texto"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResposta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto"
            tools:text="Equipe de manutenção agendada para 24/10." />
    </LinearLayout>
</LinearLayout>
