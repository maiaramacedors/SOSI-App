<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMotivoCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="RECLAMACAO — TRANSITO" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/Badge"
            android:background="@drawable/bg_badge_andamento"
            android:textColor="@color/status_andamento_texto"
            tools:text="Em andamento" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="15sp"
        tools:text="Av. Presidente Vargas - Centro" />

    <TextView
        android:id="@+id/txtInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_claro"
        android:textSize="13sp"
        tools:text="João Silva · (19) 99999-0000 · Ocorrido em 2026-10-12" />
</LinearLayout>
